{
  "name": "solgate",
  "private": true,
  "version": "0.2.1",
  "description": "Open-source, modular allowlist & eligibility framework for Solana projects. Embed in any site. No launchpad lock-in.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev:server": "pnpm --filter @solgate/server dev",
    "dev:admin": "pnpm --filter @solgate/admin dev",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsup": "^8.3.0",
    "vitest": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Solgate-code/solgate.git"
  },
  "homepage": "https://github.com/Solgate-code/solgate"
}
