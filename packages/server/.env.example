PORT=8787
BASE_URL=http://localhost:8787
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_API_KEY=change-me-admin-key
ALLOWLIST_DB=allowlist.db          # or "memory"
CORS_ORIGINS=http://localhost:3000,https://myproject.xyz
ELIGIBILITY_LOOKUP=minimal          # minimal | full | protected
TRUST_PROXY=none                    # none | cloudflare | x-forwarded-for  (only if a proxy you control sets the header)
ALLOWED_RETURN_ORIGINS=             # extra origins OAuth may redirect back to (CORS origins are allowed automatically)
ALLOW_INSECURE_WEBHOOKS=false       # allow http:// webhook targets (dev only)

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DAS_URL=https://mainnet.helius-rpc.com/?api-key=...   # any DAS endpoint; needed for NFT checks

X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=                 # only for role checks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

TURNSTILE_SECRET=
HCAPTCHA_SECRET=
