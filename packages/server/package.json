{
  "name": "@solgate/server",
  "version": "0.2.1",
  "description": "Self-hostable allowlist API: wallet auth, on-chain + social verification, exports, webhooks. Runs on Node, Vercel, Cloudflare Workers or Deno.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "bin": {
    "solgate": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@solgate/core": "workspace:*",
    "bs58": "^6.0.0",
    "hono": "^4.6.3",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Solgate-code/solgate.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Solgate-code/solgate"
}
