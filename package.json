{
  "name": "solana-allowlist",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, modular allowlist & eligibility framework for Solana projects. Embed in any site. No launchpad lock-in.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev:server": "pnpm --filter @solana-allowlist/server dev",
    "dev:admin": "pnpm --filter @solana-allowlist/admin dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsup": "^8.3.0",
    "vitest": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Solgate-code/solana-allowlist.git"
  },
  "homepage": "https://github.com/Solgate-code/solana-allowlist"
}
