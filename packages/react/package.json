{
  "name": "@solgate/react",
  "version": "0.2.0",
  "description": "Embeddable React allowlist widget + headless client/hooks for Solana projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react,react-dom && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@solgate/core": "workspace:*",
    "@wallet-standard/app": "^1.0.1",
    "@wallet-standard/base": "^1.0.1",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Solgate-code/solgate.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Solgate-code/solgate"
}
